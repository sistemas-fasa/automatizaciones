import logging
from datetime import date
from calendar import monthrange
from decimal import Decimal, ROUND_HALF_UP

import pandas as pd

from config import cfg
from db import query_all, query_one
from models import ProyeccionResultado, ResumenProveedor

logger = logging.getLogger(__name__)


def normalizar_codigo(valor: object) -> str:
    """Replica la igualdad de campos CHAR de VFP eliminando relleno lateral."""
    return str(valor or "").strip()


def redondear_vfp(valor: float, decimales: int) -> float:
    quantum = Decimal(1).scaleb(-decimales)
    return float(Decimal(str(valor)).quantize(quantum, rounding=ROUND_HALF_UP))


def importe_vfp(cantidad: float, costo: float) -> Decimal:
    return (Decimal(str(cantidad)) * Decimal(str(costo))).quantize(
        Decimal("0.001"), rounding=ROUND_HALF_UP
    )


def fin_de_mes(d: date) -> date:
    """Último día del mes de la fecha dada."""
    ultimo = monthrange(d.year, d.month)[1]
    return date(d.year, d.month, ultimo)


def calcular_rango_fechas() -> tuple[date, date]:
    """Misma lógica que el VFP: depende del día 15."""
    hoy = date.today()
    if hoy.day < 15:
        desde = date(hoy.year - 1, hoy.month, 1)
        hasta = fin_de_mes(date(hoy.year, hoy.month - 1, 1))
    else:
        if hoy.month == 12:
            desde = date(hoy.year, 1, 1)
        else:
            desde = date(hoy.year - 1, hoy.month + 1, 1)
        hasta = hoy
    logger.info("Rango fechas: %s a %s", desde, hasta)
    return desde, hasta


def obtener_articulos_activos() -> list[dict]:
    """Artículos visibles que admiten pedido, igual que la selección VFP."""
    sql = """
        SELECT s.clave, a.detalle, a.disconti, s.principal,
               s.unidad, s.stock, s.campoa1, s.peso,
               s.espesor, s.mts2, s.desc0, s.admitepedido, s.visible,
               s.empresa_id
        FROM stock s
        INNER JOIN articulo a ON s.clave = a.clave
        WHERE s.visible = 'S'
          AND s.admitepedido = 'S'
          AND s.empresa_id = %(empresa_id)s
    """
    return query_all(sql, {"empresa_id": cfg.empresa_id})


def cargar_artpro_masivo(claves: list[str]) -> dict[str, list[dict]]:
    if not claves:
        return {}
    artpro_list = query_all(
        """SELECT ARTICULO as articulo, PROVEEDO as proveedo, CALCULO as calculo,
                  COSTO as costo, PARCIAL2 as parcial2, MONEDA as moneda
           FROM artpro
           WHERE ARTICULO IN ({})""".format(",".join("%s" for _ in claves)),
        claves,
    )
    result: dict[str, list[dict]] = {}
    for r in artpro_list:
        art = normalizar_codigo(r["articulo"])
        r["articulo"] = art
        r["proveedo"] = normalizar_codigo(r["proveedo"])
        result.setdefault(art, []).append(r)
    return result


def seleccionar_artpro(filas: list[dict], proveedor: str | None) -> dict | None:
    """VFP usa el ARTPro del proveedor que se está procesando."""
    if proveedor:
        for fila in filas:
            if normalizar_codigo(fila.get("proveedo")) == normalizar_codigo(proveedor):
                return fila
    return filas[0] if filas else None


def obtener_movimientos(desde: date, hasta: date) -> pd.DataFrame:
    """Obtiene movimientos de 12 meses agregados por artículo/mes/año.

    Ajusta signo: egresos (tipo='I' AND codigo='C') o (tipo='I') se niegan.
    """
    sql = """
        SELECT articulo,
               SUM(CASE
                   WHEN (tipo = 'I' AND codigo = 'C') OR tipo = 'I'
                   THEN cantidad * -1
                   ELSE cantidad
               END) as cantidad,
               MONTH(fecha) as mes,
               YEAR(fecha) as anio
        FROM movmer
        WHERE fecha >= %(desde)s
          AND fecha <= %(hasta)s
          AND cliente NOT IN ('', '50000', '00002')
          AND SUBSTRING(comp, 1, 1) <> 'A'
        GROUP BY articulo, YEAR(fecha), MONTH(fecha)
        ORDER BY articulo, anio, mes
    """
    rows = query_all(sql, {"desde": desde, "hasta": hasta})

    df = pd.DataFrame(rows)
    if df.empty:
        return df

    df["cantidad"] = df["cantidad"].astype(float)

    return df


def convertir_unidad_stock(
    valor: float, campo_a1: str, peso: float, espesor: float, mts2: float
) -> float:
    """Convierte stock o promedio según campoa1 (modo unidades de compra)."""
    if campo_a1 == "C":
        return valor * peso if peso else valor
    elif campo_a1 == "M":
        return valor / peso if peso else valor
    elif campo_a1 == "S":
        divisor = espesor * 8 if espesor else 1
        return valor / divisor
    elif campo_a1 == "A":
        return valor / mts2 if mts2 else valor
    return valor


def aplicar_formula_conversion(
    valor: float, formula: str | None, peso: float = 0
) -> float:
    if not formula or not formula.strip():
        return valor
    try:
        PESO = peso
        resultado = eval(f"{valor} {formula}")
        return float(resultado)
    except Exception:
        logger.warning("Error evaluando formula '%s' con valor %s", formula, valor)
        return valor


def calcular_valores_vfp(
    *,
    suma_movimientos: float,
    meses_con_movimiento: int,
    meses_proyectados: int,
    formula: str | None,
    peso: float,
    stock_central: float,
    stock_sucursal: float,
    saldo_pedidos: float,
    discontinuado: bool,
) -> dict[str, float]:
    """Replica las magnitudes del cursor ``proy`` de ``proyeccion_compra``."""
    promedio_periodos = (
        suma_movimientos / meses_con_movimiento if meses_con_movimiento else 0.0
    )
    promedio_mensual_base = redondear_vfp(suma_movimientos / 12.0, 3)
    promedio_periodos = redondear_vfp(
        aplicar_formula_conversion(promedio_periodos, formula, peso), 2
    )
    promedio_mensual = redondear_vfp(
        aplicar_formula_conversion(promedio_mensual_base, formula, peso), 3
    )

    proyeccion = 0.0
    if not discontinuado:
        entrada_proyeccion = redondear_vfp(
            promedio_mensual_base * meses_proyectados, 4
        )
        proyeccion = redondear_vfp(
            aplicar_formula_conversion(entrada_proyeccion, formula, peso), 3
        )

    stock_central_convertido = redondear_vfp(
        aplicar_formula_conversion(redondear_vfp(stock_central, 3), formula, peso), 3
    )
    stock_sucursal_convertido = aplicar_formula_conversion(
        redondear_vfp(stock_sucursal, 3), formula, peso
    )
    stock = redondear_vfp(stock_central_convertido + stock_sucursal_convertido, 4)
    pedido_sugerido = redondear_vfp(
        max(0.0, proyeccion - stock - saldo_pedidos), 4
    )
    return {
        "promedio_periodos": promedio_periodos,
        "promedio_mensual": promedio_mensual,
        "proyeccion": proyeccion,
        "stock": stock,
        "pedido_sugerido": pedido_sugerido,
    }


def resolver_pedido_real(pedido_sugerido: float, pedido_guardado: float | None) -> float:
    """VFP reemplaza ``pedareal`` por el pedido pendiente guardado, si existe."""
    return pedido_sugerido if pedido_guardado is None else pedido_guardado
def obtener_tipo_cambio() -> float:
    row = query_one(
        """SELECT pesos FROM dolar_proveedor
           ORDER BY fecha DESC, id DESC LIMIT 1"""
    )
    if row:
        return float(row["pesos"])
    return 1.0


def calcular_costo_unitario(artpro_row: dict, tc: float) -> float:
    costo = float(artpro_row.get("parcial2", 0) or 0)
    moneda = artpro_row.get("moneda", "")
    if moneda == "D":
        costo = costo * tc
    return costo


def obtener_pedidos_pendientes(
    articulos_principales: dict[str, str] | None = None,
) -> dict[str, float]:
    """Obtiene saldo de pedidos pendientes agrupados por artículo."""
    periodo_actual = date.today().strftime("%Y%m")
    sql = """
        SELECT articulo, SUM(saldo) as saldo_total
        FROM pedpro
        WHERE saldo > 0
          AND (periodo <= %(periodo)s OR periodo = '' OR periodo IS NULL)
        GROUP BY articulo
    """
    rows = query_all(sql, {"periodo": periodo_actual})
    saldos = {
        normalizar_codigo(r["articulo"]): float(r["saldo_total"]) for r in rows
    }
    for articulo, principal in (articulos_principales or {}).items():
        if principal and articulo in saldos:
            saldos[principal] = saldos.get(principal, 0.0) + saldos[articulo]
    return saldos


def obtener_stock_sucursal() -> dict[str, float]:
    """Stock adicional que VFP suma explícitamente desde la sucursal 3."""
    rows = query_all(
        """SELECT clave, SUM(stock) AS stock_total
           FROM stocksuc
           WHERE sucursal = 3
           GROUP BY clave"""
    )
    return {
        normalizar_codigo(r["clave"]): float(r["stock_total"] or 0) for r in rows
    }


def obtener_pedidos_guardados(meses_proyectados: int) -> dict[tuple[str, str], float]:
    rows = query_all(
        """SELECT proveedor, articulo, SUM(pedido) AS pedido
           FROM ProyCompra
           WHERE estado = 'P' AND mesesproyeccion = %(meses)s
           GROUP BY proveedor, articulo""",
        {"meses": meses_proyectados},
    )
    return {
        (normalizar_codigo(r["proveedor"]), normalizar_codigo(r["articulo"])): float(
            r["pedido"] or 0
        )
        for r in rows
    }


def obtener_info_proveedores() -> dict[str, dict]:
    rows = query_all(
        "SELECT PROVEEDOR as proveedor, NOMBRE as nombre, DOLAR as dolar "
        "FROM PROVEEDO"
    )
    return {normalizar_codigo(r["proveedor"]): r for r in rows}


def calcular_proyecciones() -> list[ResumenProveedor]:
    """Orquesta todo el cálculo y devuelve resultados agrupados por proveedor."""
    desde, hasta = calcular_rango_fechas()
    meses_proy = cfg.proy_meses

    articulos = obtener_articulos_activos()
    if not articulos:
        logger.warning("No se encontraron artículos activos.")
        return []

    logger.info("Artículos activos encontrados: %d", len(articulos))

    mov_df = obtener_movimientos(desde, hasta)
    articulos_principales = {
        normalizar_codigo(a["clave"]): normalizar_codigo(a.get("desc0"))
        for a in articulos
    }
    pedidos_pendientes = obtener_pedidos_pendientes(articulos_principales)
    stock_sucursal = obtener_stock_sucursal()
    pedidos_guardados = obtener_pedidos_guardados(meses_proy)
    proveedores = obtener_info_proveedores()
    logger.info("Movimientos cargados: %d registros", len(mov_df))

    # Armar diccionario de movimientos por artículo: {clave: [cant_mes1, cant_mes2, ...]}
    mov_por_articulo: dict[str, list[float]] = {}
    if not mov_df.empty:
        for art_code, grupo in mov_df.groupby("articulo"):
            mov_por_articulo[normalizar_codigo(art_code)] = grupo["cantidad"].tolist()

    # Cargar artpro batch para todas las claves
    claves = [normalizar_codigo(a["clave"]) for a in articulos]
    artpro_dict = cargar_artpro_masivo(claves)

    # Indexar proveedor principal: usar stock.principal si existe, si no artpro
    proveedor_principal: dict[str, str] = {}
    for a in articulos:
        pk = normalizar_codigo(a["clave"])
        p_field = normalizar_codigo(a["principal"])
        if p_field:
            proveedor_principal[pk] = p_field
        else:
            ar = seleccionar_artpro(artpro_dict.get(pk, []), None)
            if ar:
                proveedor_principal[pk] = ar["proveedo"]

    resultados_individuales: list[ProyeccionResultado] = []

    for art in articulos:
        clave = normalizar_codigo(art["clave"])
        detalle = art["detalle"]
        unidad = art["unidad"]
        campo_a1 = (art["campoa1"] or "").strip()
        peso = float(art["peso"] or 0)
        espesor = float(art["espesor"] or 0)
        mts2 = float(art["mts2"] or 0)
        stock_val = float(art["stock"] or 0)

        prov = normalizar_codigo(proveedor_principal.get(clave))
        if not prov:
            logger.debug("Artículo %s sin proveedor principal, saltando", clave)
            continue

        proveedor_info = proveedores.get(prov, {})
        nombre_prov = proveedor_info.get("nombre", prov)

        artpro_row = seleccionar_artpro(artpro_dict.get(clave, []), prov)
        formula = artpro_row["calculo"] if artpro_row else None

        movs = mov_por_articulo.get(clave, [])
        saldo_ped = pedidos_pendientes.get(clave, 0.0)
        valores = calcular_valores_vfp(
            suma_movimientos=sum(movs),
            meses_con_movimiento=len(movs),
            meses_proyectados=meses_proy,
            formula=formula,
            peso=peso,
            stock_central=stock_val,
            stock_sucursal=stock_sucursal.get(clave, 0.0),
            saldo_pedidos=saldo_ped,
            discontinuado=(art["disconti"] or "").strip() == "S",
        )
        pedido_real = resolver_pedido_real(
            valores["pedido_sugerido"], pedidos_guardados.get((prov, clave))
        )

        tc_proveedor = float(proveedor_info.get("dolar", 1) or 1)
        costo_unitario = (
            calcular_costo_unitario(artpro_row, tc_proveedor) if artpro_row else 0.0
        )

        resultados_individuales.append(
            ProyeccionResultado(
                articulo=clave,
                detalle=detalle,
                unidad=unidad,
                proveedor=prov,
                nombre_proveedor=nombre_prov,
                stock_actual=round(valores["stock"], 3),
                promedio_mensual=round(valores["promedio_mensual"], 3),
                proyeccion_bruta=round(valores["proyeccion"], 3),
                saldo_pedidos=round(saldo_ped, 3),
                pedido_sugerido=redondear_vfp(valores["pedido_sugerido"], 4),
                pedido_real=redondear_vfp(pedido_real, 4),
                meses_proyectados=meses_proy,
                formula_conversion=formula,
                costo_unitario=round(costo_unitario, 3),
            )
        )

    logger.info("Proyecciones calculadas: %d artículos", len(resultados_individuales))

    # Agrupar por proveedor
    grupos: dict[str, list[ProyeccionResultado]] = {}
    for r in resultados_individuales:
        grupos.setdefault(r.proveedor, []).append(r)

    resumenes: list[ResumenProveedor] = []
    for cod_prov, articulos_list in sorted(grupos.items()):
        nombre = articulos_list[0].nombre_proveedor
        total_stock = sum(a.stock_actual for a in articulos_list)
        total_proy = sum(a.proyeccion_bruta for a in articulos_list)
        total_pedido = sum(a.pedido_sugerido for a in articulos_list)
        total_pedido_real = sum(a.pedido_real for a in articulos_list)
        total_costo_stock = sum(
            a.stock_actual * a.costo_unitario for a in articulos_list
        )
        # VFP TotalProy se valoriza con ``proyped`` (proyección neta de stock
        # y pedidos pendientes), no con la proyección bruta.
        total_costo_proy = float(
            sum(
                importe_vfp(a.pedido_sugerido, a.costo_unitario)
                for a in articulos_list
            )
        )
        total_costo_pedido = total_costo_proy
        total_costo_pedido_real = float(
            sum(
                importe_vfp(a.pedido_real, a.costo_unitario)
                for a in articulos_list
            )
        )
        resumenes.append(
            ResumenProveedor(
                codigo=cod_prov,
                nombre=nombre,
                cantidad_articulos=len(articulos_list),
                total_stock=round(total_stock, 3),
                total_proyeccion=round(total_proy, 3),
                total_pedido_sugerido=round(total_pedido, 3),
                total_pedido_real=round(total_pedido_real, 3),
                total_costo_stock=round(total_costo_stock, 2),
                total_costo_proyeccion=redondear_vfp(total_costo_proy, 3),
                total_costo_pedido=redondear_vfp(total_costo_pedido, 3),
                total_costo_pedido_real=redondear_vfp(total_costo_pedido_real, 3),
                articulos=articulos_list,
            )
        )

    logger.info("Proveedores con proyección: %d", len(resumenes))
    return resumenes


def resumen_a_dataframe(resumenes: list[ResumenProveedor]) -> pd.DataFrame:
    """Convierte la lista de resúmenes a un DataFrame fila por artículo."""
    rows = []
    for prov in resumenes:
        for art in prov.articulos:
            rows.append(
                {
                    "Proveedor": f"{prov.codigo} - {prov.nombre}",
                    "Articulo": art.articulo,
                    "Detalle": art.detalle,
                    "Unidad": art.unidad,
                    "Stock Actual": art.stock_actual,
                    "Prom. Mensual": art.promedio_mensual,
                    "Proyeccion": art.proyeccion_bruta,
                    "Saldo Pedidos": art.saldo_pedidos,
                    "Pedido Sugerido": art.pedido_sugerido,
                }
            )
    return pd.DataFrame(rows)
