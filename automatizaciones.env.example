# Copy to /srv/env/automatizaciones.env outside Git and fill locally.
# Never commit real values or paste them into chat.

# Database
DB_HOST=
DB_PORT=3306
DB_DATABASE=fasa
DB_USERNAME=
DB_PASSWORD=

# SMTP
SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SECURITY=
SMTP_TIMEOUT=30
FROM_EMAIL=
TO_EMAILS=
BCC_EMAILS=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false

# Projection and report output
PROY_MESES=3
EMPRESA_ID=1
EXCEL_OUTPUT_DIR=/data/exports
FACTURAS_ENV_FILE=
